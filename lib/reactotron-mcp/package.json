{
  "name": "@hurajgor/reactotron-mcp",
  "version": "0.1.0",
  "description": "MCP server for Reactotron: lets agents read debug events, drive the UI and control devices.",
  "author": "Infinite Red",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/h4rz/reactotron/issues"
  },
  "homepage": "https://github.com/h4rz/reactotron/tree/development/lib/reactotron-mcp",
  "repository": "https://github.com/h4rz/reactotron/tree/development/lib/reactotron-mcp",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/typescript/commonjs/src/index.d.ts",
      "module": "./dist/module/index.js",
      "default": "./dist/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsup",
    "clean": "rimraf ./dist",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "zod": "^4.3.0"
  },
  "peerDependencies": {
    "@hurajgor/reactotron-core-contract": "*",
    "@hurajgor/reactotron-core-server": "*"
  },
  "devDependencies": {
    "@hurajgor/reactotron-core-contract": "workspace:*",
    "@hurajgor/reactotron-core-server": "workspace:*",
    "@types/node": "^18.18.8",
    "get-port-please": "^3.1.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "rimraf": "5.0.5",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.[tj]s"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  }
}
