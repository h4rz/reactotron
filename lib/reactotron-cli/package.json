{
  "name": "@hurajgor/reactotron-cli",
  "version": "0.1.0",
  "description": "Agent-friendly command line interface for Reactotron.",
  "author": "Infinite Red",
  "license": "MIT",
  "repository": "https://github.com/h4rz/reactotron/tree/development/lib/reactotron-cli",
  "homepage": "https://github.com/h4rz/reactotron/tree/development/lib/reactotron-cli",
  "bugs": {
    "url": "https://github.com/h4rz/reactotron/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "bin": {
    "reactotron": "./dist/commonjs/cli.js",
    "reactotron-agent": "./dist/commonjs/cli.js"
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/module/index.js",
  "types": "./dist/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/typescript/commonjs/src/index.d.ts",
      "module": "./dist/module/index.js",
      "default": "./dist/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsup && tsc --emitDeclarationOnly --declaration --outDir dist/typescript/commonjs",
    "clean": "rimraf ./dist",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^18.18.8",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "rimraf": "5.0.5",
    "ts-jest": "^29.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.[tj]s"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  }
}
